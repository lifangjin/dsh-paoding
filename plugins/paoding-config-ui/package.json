{
  "name": "paoding-config-ui",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "description": "庖丁 (dsh-paoding) 可视化配置器 — DSH Web 设置页集成插件（settings.section 分区 + /api/paoding 路由）",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
