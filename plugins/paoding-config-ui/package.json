{
  "name": "paoding-config-ui",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "icon": "./icon.svg",
  "description": "庖丁 (dsh-paoding) 可视化配置器 — DSH Web 左侧栏全页配置插件（侧栏入口 + /api/paoding 路由）· Visual config panel for dsh-paoding in the DSH Web sidebar",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.5 <0.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
